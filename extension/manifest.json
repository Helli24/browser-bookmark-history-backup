{
  "manifest_version": 3,
  "name": "Bookmark & History Backup",
  "version": "2026.9.19.1",
  "description": "Bookmarks and history into a folder you choose, once a day. Keeps a searchable index of every page, long after the browser forgets.",
  "key": "",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "history",
    "storage",
    "alarms",
    "unlimitedStorage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark & History Backup"
  },
  "options_page": "options.html"
}
