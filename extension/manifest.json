{
  "manifest_version": 3,
  "name": "Chrome Backup - Bookmarks & History",
  "version": "2026.9.14.6",
  "description": "Backs up bookmarks and browsing history once a day into a folder of your choice, and keeps a permanent first-visit index.",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Backup"
  },
  "options_page": "options.html"
}
